rules_version = '2';

// Sketch for the ticketsystem MVP.
// Roles come from Firebase Auth custom claims: request.auth.token.role
//   admin  — full access
//   agent  — create/update tickets and comments
//   viewer — read only
// Tighten field validation before production.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isAgent() {
      return isSignedIn() && role() == 'agent';
    }

    function isViewer() {
      return isSignedIn() && role() == 'viewer';
    }

    function isStaff() {
      return isAdmin() || isAgent() || isViewer();
    }

    function isWriter() {
      return isAdmin() || isAgent();
    }

    match /tickets/{ticketId} {
      allow read: if isStaff();

      allow create: if isWriter()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['open', 'in_progress', 'done', 'closed']
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];

      allow update: if isWriter()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['open', 'in_progress', 'done', 'closed']
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isStaff();

        allow create: if isWriter()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0;

        allow update, delete: if isAdmin();
      }
    }

    // Optional directory of agents/viewers for assignee pickers.
    // Source of truth for authorization remains custom claims.
    match /members/{uid} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
